# Copier en .env puis renseigner. Ne JAMAIS committer .env.

# --- Base de données (docker compose)
POSTGRES_PASSWORD=changer-moi
# Hors Docker : URL complète
# DDW_DATABASE_URL=postgresql+psycopg://ddw:motdepasse@localhost:5432/ddw

# --- Sécurité
# Jeton obligatoire pour toute écriture (sources, règles, statuts). Générer : python -c "import secrets;print(secrets.token_urlsafe(32))"
DDW_ADMIN_TOKEN=
# Facultatif : exige un jeton pour toute lecture de l'API
DDW_READ_TOKEN=
DDW_CORS_ORIGINS=http://localhost:3000
DDW_RATE_LIMIT_PER_MINUTE=240

# --- Collecte
# Identifiez-vous auprès des sites collectés (mettre une adresse de contact réelle)
DDW_USER_AGENT=DefenseDroneWatch/0.1 (veille sources ouvertes; contact: vous@exemple.fr)
DDW_RESPECT_ROBOTS=true
DDW_HTTP_TIMEOUT_S=20
DDW_MAX_RESPONSE_BYTES=5242880
DDW_WORKER_CONCURRENCY=4
DDW_WORKER_POLL_S=30
# Réseau à proxy obligatoire sans DNS local : déléguer la résolution au proxy (voir docs/ARCHITECTURE.md)
DDW_TRUST_EGRESS_PROXY=false
# NE JAMAIS activer en production (désactive la protection SSRF ; réservé aux tests)
DDW_ALLOW_PRIVATE_HOSTS=false

# --- Déduplication
DDW_DEDUP_TITLE_THRESHOLD=0.88
DDW_DEDUP_WINDOW_DAYS=7

# --- Connecteurs réseaux sociaux (phase 6, non implémentés : laisser vide)
DDW_X_BEARER_TOKEN=
DDW_LINKEDIN_CLIENT_ID=
DDW_LINKEDIN_CLIENT_SECRET=

# --- Interface
NEXT_PUBLIC_API_URL=http://localhost:8000
DDW_LOG_LEVEL=INFO
